{
  "name": "turnstone-desktop",
  "version": "0.1.1",
  "description": "Desktop client for the Turnstone AI orchestration platform",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:contract": "vitest run --project contract",
    "test:renderer": "vitest run --project renderer",
    "test:shuffle": "node tests/helpers/run-shuffled.mjs",
    "test:e2e": "node tests/helpers/run-e2e.mjs"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.6.0",
    "@electron-forge/maker-deb": "^7.6.0",
    "@electron-forge/maker-dmg": "^7.6.0",
    "@electron-forge/maker-squirrel": "^7.6.0",
    "@electron-forge/maker-zip": "^7.6.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@reforged/maker-appimage": "^5.2.0",
    "acorn": "^8.16.0",
    "electron": "^40.8.0",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.64.1",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "electron-store": "^10.1.0"
  },
  "author": "Turnstone Labs",
  "license": "BUSL-1.1"
}
